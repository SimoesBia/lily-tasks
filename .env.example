# Copie para ".env" (que o .gitignore já ignora) e preencha. NUNCA faça commit do .env.
# Chave gratuita: https://aistudio.google.com/apikey  (sem cartão de crédito)
GEMINI_API_KEY=
# Modelo: confira no AI Studio qual modelo "Flash" está disponível na sua camada gratuita.
GEMINI_MODEL=gemini-flash-latest
LILY_TIMEZONE=America/Sao_Paulo
# Força o modo demonstração mesmo com chave configurada (1 = sim)
LILY_FORCE_DEMO=0
# Limites (opcionais)
LILY_LLM_TIMEOUT_S=30
LILY_LLM_MAX_RETRIES=3
LILY_RATE_LIMIT_PER_MIN=12
LILY_SESSION_TTL_HOURS=6
# Em Space público a chave do servidor é IGNORADA, a menos que você libere (gasta SUA cota):
LILY_ALLOW_SHARED_KEY=0
